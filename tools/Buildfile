  sh ./build/stage2 -strict -F go -T ir -o build/stage2_compiler_b.irt ./std/compiler/
  sh chmod 600 build/stage2_compiler_a.irt build/stage2_compiler_b.irt
  sh cmp build/stage2_compiler_a.irt build/stage2_compiler_b.irt
  sh ./build/stage2 -strict -F ir -o build/stage3_from_ir - < build/stage2_compiler_a.irt
  sh chmod +x build/stage3_from_ir
  sh ./build/stage3_from_ir -strict -F go -T ir -o - ./std/compiler/ > build/stage3_compiler.irt
  sh chmod 600 build/stage3_compiler.irt
  sh cmp build/stage2_compiler_a.irt build/stage3_compiler.irt
  sh cp build/stage3_from_ir build/stage3_from_ir.ref
  sh ./build/stage3_from_ir.ref -strict -F ir -o build/stage3_from_ir - < build/stage3_compiler.irt
  sh chmod +x build/stage3_from_ir
  sh cmp build/stage3_from_ir.ref build/stage3_from_ir && echo "PASS: text IR fixed-point self-hosting OK"

